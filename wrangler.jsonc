{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "link-cleaner",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/link", "/link/*"]
  },
  "routes": [
    {
      "pattern": "beetya.ng/link",
      "zone_name": "beetya.ng"
    },
    {
      "pattern": "beetya.ng/link/*",
      "zone_name": "beetya.ng"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
